# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Full HTTPS URL where Telegram will POST updates (must be publicly accessible)
# Example: https://your-domain.com  OR  https://xxxx.ngrok-free.app
WEBHOOK_URL=https://your-domain.com

# A secret string you choose (alphanumeric + hyphens, 1-256 chars)
# Passed as X-Telegram-Bot-Api-Secret-Token header; Telegram will validate it
WEBHOOK_SECRET=your_super_secret_webhook_token_here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskbot

# ─── Registration ─────────────────────────────────────────────────────────────
# Options: open | invite | approval
REGISTRATION_MODE=open

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated Telegram chat IDs that have admin privileges
# Example: 123456789,987654321
ADMIN_CHAT_IDS=123456789

# ─── Separate Alert Bot (Optional) ───────────────────────────────────────────
# Dedicated bot token and destination chat/channel ID for administrative alerts (e.g. new user registrations)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
