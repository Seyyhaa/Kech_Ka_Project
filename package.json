{
  "name": "telegram-task-manager-bot",
  "version": "1.0.0",
  "description": "A personal task manager Telegram bot built with Express.js, grammy, and PostgreSQL",
  "main": "src/app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node migrate.js",
    "test": "node test_quick.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "dependencies": {
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "grammy": "^1.29.0",
    "helmet": "^7.1.0",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.6.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  },
  "nodemonConfig": {
    "ignore": [
      "db/migrations/*"
    ],
    "ext": "js,json"
  }
}
